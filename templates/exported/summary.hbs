<form class="flexrow">    
<section class="helyx-summary-content">
    <h1 class="helyx-summary-title">{{title}}</h1>

    <div>
        <div style="width: 600px; height: 300px; border-radius: 5px; border: 1px solid;
            background-image: url('{{cover.filename}}'); 
            background-repeat: no-repeat; 
            background-position-x: {{cover.css_x}}; 
            background-position-y: {{cover.css_y}};
            background-size: {{cover.css_size}};
            margin-left: auto;
            margin-right: auto;" />
        </div>      
    </div>

    <section class="helyx-summary-overview">
        <h2>Overview</h2>
        <div class="helyx-summary-summary">{{{summary_html}}}</div>
    </section>

    <hr/>

    <section class="helyx-summary-options" style="normal">

        <div class="form-group" style="display: {{options.use_external_art_mappings}};">
            <label for="helyx-external-art-mapping">External Art Mapping</label>
            <div class="form-fields" style="display:block;">
                <select name="helyx-external-art-mapping" id="helyx-external-art-mapping">
                    <option value="">--None--</option>
                    {{#each options.external_art_mappings}}
                        <option value="{{this.idname}}">{{this.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>      

        <div class="form-group" style="display: {{options.tokens_on_maps}}">
            <label for="helyx-accept-tokens-on-maps">Put tokens on maps</label>
            <div class="form-fields" style="display:block;">
                <input type="checkbox" id="helyx-accept-tokens-on-maps" />
            </div>
        </div>  

    </section>
</form>